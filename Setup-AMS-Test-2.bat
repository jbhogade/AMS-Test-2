@echo off
REM -------------------------------------------------------------
REM  AMS-Test-2 - one-time setup (Windows)
REM
REM  Asks once: "Where should the data live?"
REM    MS SQL Server  (DEFAULT, same engine as the old AMS-Test)
REM       -> prompts for host / login, creates the AMS-TEST-2
REM          database, saves db-config.bat, migrates + seeds.
REM    SQLite  (fallback, single file db.sqlite3)
REM       -> migrates + seeds, saves db-config.bat with AMS_DB=sqlite
REM          so the choice persists.
REM
REM  You can switch later at any time by re-running this script or
REM  Setup-SQL-Server.bat.
REM -------------------------------------------------------------
title AMS-Test-2 Setup
cd /d "%~dp0"

where python >nul 2>nul
if errorlevel 1 (
    echo Python was not found. Install Python 3.11+ from python.org
    echo and tick "Add python.exe to PATH" during setup.
    pause
    exit /b 1
)

if not exist "venv\Scripts\python.exe" (
    echo Creating virtual environment...
    python -m venv venv
)

call venv\Scripts\activate.bat

echo Installing requirements...
python -m pip install --upgrade pip
pip install -r requirements.txt

echo.
echo =============================================================
echo   Where should the portal store its data?
echo.
echo   Y = MS SQL Server  (default - database AMS-TEST-2)
echo   n = SQLite         (single file db.sqlite3, no server)
echo.
set /p USE_MSSQL=Store data in MS SQL Server? [Y/n]:

if /I "%USE_MSSQL%"=="N" goto SQLITE

REM -------------------------------------------------------------
REM  SQL Server path - same steps as Setup-SQL-Server.bat
REM -------------------------------------------------------------
echo.
set /p AMS_DB_HOST=SQL Server host or named instance (default: localhost):
if "%AMS_DB_HOST%"=="" set AMS_DB_HOST=localhost

REM  A named instance (host\SQLEXPRESS) has no fixed port - the SQL
REM  Server Browser service resolves it, so the port stays blank.
echo %AMS_DB_HOST% | findstr /C:"\\" >nul
if not errorlevel 1 set AMS_DB_PORT=

set /p AMS_DB_PORT=Port (default 1433 - leave BLANK for a named instance):
if "%AMS_DB_PORT%"=="" if not "%AMS_DB_HOST:*\=%"=="%AMS_DB_HOST%" set AMS_DB_PORT=

set /p AMS_DB_USER=Login user (default: sa - leave BLANK for Windows Authentication):
if "%AMS_DB_USER%"=="" (
    set AMS_DB_TRUSTED=yes
    set AMS_DB_PASSWORD=
) else (
    set AMS_DB_TRUSTED=no
    set /p AMS_DB_PASSWORD=Login password:
)

echo.
echo --- Creating AMS-TEST-2 database (if missing) -----------------
if "%AMS_DB_TRUSTED%"=="yes" (
    sqlcmd -S "%AMS_DB_HOST%" -E -b -i "sqlserver\01-create-database.sql" 2>nul
) else (
    sqlcmd -S "%AMS_DB_HOST%,%AMS_DB_PORT%" -U "%AMS_DB_USER%" -P "%AMS_DB_PASSWORD%" -b -i "sqlserver\01-create-database.sql" 2>nul
)
if errorlevel 1 echo sqlcmd could not create it now - dbdoctor will create it below.

set AMS_DB=mssql
set AMS_DB_NAME=AMS-TEST-2
> "db-config.bat" echo @echo off
>> "db-config.bat" echo REM Auto-generated by Setup-AMS-Test-2.bat - SQL Server mode.
>> "db-config.bat" echo set AMS_DB=mssql
>> "db-config.bat" echo set AMS_DB_NAME=AMS-TEST-2
>> "db-config.bat" echo set AMS_DB_HOST=%AMS_DB_HOST%
if not "%AMS_DB_PORT%"=="" >> "db-config.bat" echo set AMS_DB_PORT=%AMS_DB_PORT%
if "%AMS_DB_TRUSTED%"=="yes" (
    >> "db-config.bat" echo set AMS_DB_TRUSTED_CONNECTION=yes
) else (
    >> "db-config.bat" echo set AMS_DB_USER=%AMS_DB_USER%
    >> "db-config.bat" echo set AMS_DB_PASSWORD=%AMS_DB_PASSWORD%
)

echo.
echo --- Verifying the connection (database doctor) ----------------
python manage.py dbdoctor --create-database
if errorlevel 1 (
    echo.
    echo The connection test found a problem. Apply the printed fixes
    echo and re-run this script. You can re-test any time with
    echo Test-SQL-Connection.bat.
    pause
    exit /b 1
)

echo.
echo --- Creating tables in AMS-TEST-2 (migrate) -------------------
python manage.py migrate
if errorlevel 1 (
    echo.
    echo migrate hit an existing-schema conflict (e.g. error 2714
    echo "There is already an object named ...") - the database already
    echo contains tables. Repairing them with dbrepair and retrying...
    echo.
    python manage.py dbrepair
    if errorlevel 1 (
        echo dbrepair could not fix everything - see the messages above.
        pause
        exit /b 1
    )
    echo.
    echo --- Retrying migrate (should report: No migrations to apply) ---
    python manage.py migrate
    if errorlevel 1 (
        echo Migration still failing - see the messages above.
        echo Run Repair-Database.bat for the full diagnosis.
        pause
        exit /b 1
    )
)
echo.
echo --- Seeding the two login accounts ----------------------------
python manage.py seed_admins

echo.
echo =============================================================
echo  Setup complete - data storage: SQL Server (AMS-TEST-2 on
echo  %AMS_DB_HOST%).
echo  Logins:  operator.sys / Sr#Ops@2026   (Supreme Root)
echo           testadmin   / Admin@#$12345  (Super Root)
echo.
echo  Data from the OLD AMS-Test? Run Import-From-AMS-Test.bat
echo =============================================================
pause
exit /b 0

:SQLITE
REM -------------------------------------------------------------
REM  SQLite path - save the choice so run-django.bat honors it
REM -------------------------------------------------------------
> "db-config.bat" echo @echo off
>> "db-config.bat" echo REM Auto-generated by Setup-AMS-Test-2.bat - SQLite mode.
>> "db-config.bat" echo set AMS_DB=sqlite

echo.
echo --- Migrating SQLite database ---------------------------------
set AMS_DB=sqlite
python manage.py migrate
if errorlevel 1 (
    echo.
    echo migrate hit an existing-schema conflict - repairing with dbrepair...
    python manage.py dbrepair
    if errorlevel 1 (
        echo dbrepair could not fix everything - see the messages above.
        pause
        exit /b 1
    )
    echo.
    echo --- Retrying migrate (should report: No migrations to apply) ---
    python manage.py migrate
)
echo.
echo --- Seeding login accounts ------------------------------------
python manage.py seed_admins

echo.
echo =============================================================
echo  Setup complete - data storage: SQLite (db.sqlite3).
echo  Run run-django.bat to start the portal.
echo  Logins:  operator.sys / Sr#Ops@2026   (Supreme Root)
echo           testadmin   / Admin@#$12345  (Super Root)
echo.
echo  Switch to SQL Server later: run Setup-SQL-Server.bat,
echo  then Copy-Data-SQLite-to-SQLServer.bat to move existing data.
echo =============================================================
pause
